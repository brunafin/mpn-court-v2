echo "pre-push: testes locais antes da sandbox"

sandbox=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_ref" = "refs/heads/sandbox" ]; then
    sandbox=1
  fi
done

if [ "$sandbox" != 1 ]; then
  echo "pre-push: destino não é sandbox, testes pulados"
  exit 0
fi

api_dir="${E2E_API_DIR:-../mpn-api}"
npm test
npm --prefix "$api_dir" run db:e2e:up
npm run test:e2e
