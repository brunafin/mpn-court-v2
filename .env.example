VITE_WHATSAPP_URL_BASE=
VITE_API_URL_BASE=
VITE_ENVIRONMENT=
# Site público (links de Privacidade / Termos). Local: http://localhost:3000
VITE_PUBLIC_SITE_URL=http://localhost:3000
# Google Sign-In — mesmo Client ID (Web) configurado em GOOGLE_CLIENT_ID na API.
# Origins autorizados: http://localhost:5173 (ou a porta do Vite) e o domínio de prod.
VITE_GOOGLE_CLIENT_ID=
# WhatsApp para contratar / enviar comprovante (wa.me/…).
# VITE_WHATSAPP_CONTRACT_URL=https://wa.me/5551XXXXXXXXX
# VITE_WHATSAPP_RECEIPT_URL=https://wa.me/5551XXXXXXXXX
# Chave PIX estática (alternativa ao Mercado Pago) + nome do favorecido.
# VITE_MANUAL_PIX_KEY=sua-chave-pix
# VITE_MANUAL_PIX_BENEFICIARY=Marca Pra Nós
